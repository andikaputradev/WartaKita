# Supabase project settings (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only secret (never commit real value or expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Canonical website URL used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=https://wartakita.my.id

# Search Engine Indexing (default: false, set to 'true' only in production when ready)
NEXT_PUBLIC_INDEXING_ENABLED=false

# Optional editorial contact information (empty values will hide the respective section)
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_SITE_ADDRESS=
NEXT_PUBLIC_SITE_PHONE=
NEXT_PUBLIC_SITE_TWITTER=
NEXT_PUBLIC_SITE_FACEBOOK=
NEXT_PUBLIC_SITE_INSTAGRAM=
NEXT_PUBLIC_SITE_YOUTUBE=

# Ad Slot banner display (default: false)
NEXT_PUBLIC_ADS_ENABLED=false
